# Postgres connection string (Neon via the Vercel integration fills this in for you)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Resend API key (resend.com → API Keys) and a sender on a domain you verified there
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Hispanic Nomad Leads <leads@hispanicnomad.com>

# Where firm replies, sign-up alerts and dispute alerts go
ADMIN_EMAIL=contact@hispanicnomad.com

# Password for /admin, and a long random string used to sign the login cookie
ADMIN_PASSWORD=
AUTH_SECRET=

# Shared secret Pinball sends with every lead (Bearer token)
PINBALL_WEBHOOK_SECRET=

# Secret Vercel Cron sends to the monthly statement job
CRON_SECRET=

# Public address of this app, no trailing slash
APP_URL=https://your-app.vercel.app
